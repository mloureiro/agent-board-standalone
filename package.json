{
  "name": "agent-board-standalone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "release:tags": "node tools/repo/src/release-tags.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
