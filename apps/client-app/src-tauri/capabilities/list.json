{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "list",
  "description": "The server list page. Matched by webview label only.",
  "webviews": ["list"],
  "permissions": [
    "allow-list-servers",
    "allow-list-add-server",
    "allow-list-remove-server",
    "allow-open-server",
    "allow-open-all-servers",
    "allow-rename-server",
    "allow-retry-store-deletion",
    "allow-take-open-failures",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
