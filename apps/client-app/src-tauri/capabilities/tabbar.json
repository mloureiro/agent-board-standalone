{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tabbar",
  "description": "The tab bar page of a server window. Matched by webview label only: a window match would grant these permissions to every page webview in the same window.",
  "webviews": ["tabbar-*"],
  "permissions": [
    "allow-tabs-snapshot",
    "allow-tab-select",
    "allow-tab-close",
    "allow-tab-cycle",
    "allow-tab-split",
    "allow-tab-move",
    "allow-pane-close",
    "allow-pane-focus",
    "allow-split-resize",
    "allow-tabbar-banner",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
