[Unit]
Description=agent-board default dispatch: one tick

[Service]
Type=oneshot
Environment="PATH=/srv/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/flock -n -E 75 /srv/tester/.local/state/agent-board/profiles/default/run/dispatch.lock /srv/tester/.local/bin/board --profile default internal dispatch
SuccessExitStatus=75
TimeoutStartSec=120
