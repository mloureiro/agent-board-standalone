[Unit]
Description=agent-board default listen: dispatch as soon as the board says tasks changed
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=/home/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/tester/.local/bin/board --profile default internal listen
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=130

[Install]
WantedBy=default.target
