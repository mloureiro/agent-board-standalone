[Unit]
Description=agent-board default watch: runs the watches of this machine's tasks
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=/home/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/tester/.local/bin/board --profile default internal watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
