[Unit]
Description=rumo default watch: runs the watches of this machine's tasks
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=/srv/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/srv/tester/.local/bin/rumo --profile default internal watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
