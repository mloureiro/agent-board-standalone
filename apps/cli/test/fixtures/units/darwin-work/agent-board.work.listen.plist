<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agent-board.work.listen</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/opt/board/dist/board</string>
		<string>--profile</string>
		<string>work</string>
		<string>internal</string>
		<string>listen</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>130</integer>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/var/tester/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>AGENT_BOARD_CONFIG_DIR</key>
		<string>/Volumes/data/board/config</string>
		<key>AGENT_BOARD_STATE_DIR</key>
		<string>/Volumes/data/board/state</string>
		<key>AGENT_BOARD_RUN_DIR</key>
		<string>/Volumes/data/board/run</string>
		<key>XDG_STATE_HOME</key>
		<string>/Volumes/data/state</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Volumes/data/board/state/logs/launchd.listen.log</string>
	<key>StandardErrorPath</key>
	<string>/Volumes/data/board/state/logs/launchd.listen.log</string>
</dict>
</plist>
