[Unit]
Description=agent-board work dispatch: one tick

[Service]
Type=oneshot
Environment="PATH=/srv/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AGENT_BOARD_CONFIG_DIR=/srv/board work/config"
Environment="AGENT_BOARD_STATE_DIR=/srv/board work/state"
Environment="AGENT_BOARD_RUN_DIR=/srv/board work/run"
ExecStart=/usr/bin/flock -n -E 75 "/srv/board work/run/dispatch.lock" /usr/local/bin/node /opt/board/dist/board --profile work internal dispatch
SuccessExitStatus=75
TimeoutStartSec=120
