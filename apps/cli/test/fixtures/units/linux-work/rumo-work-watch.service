[Unit]
Description=rumo work watch: runs the watches of this machine's tasks
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=/srv/tester/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RUMO_CONFIG_DIR=/srv/rumo work/config"
Environment="RUMO_STATE_DIR=/srv/rumo work/state"
Environment="RUMO_RUN_DIR=/srv/rumo work/run"
ExecStart=/usr/local/bin/node /opt/board/dist/rumo --profile work internal watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
