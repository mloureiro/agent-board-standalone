<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>rumo.default.dispatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/lockf</string>
		<string>-s</string>
		<string>-t</string>
		<string>0</string>
		<string>/var/tester/.local/state/rumo/profiles/default/run/dispatch.lock</string>
		<string>/var/tester/.local/bin/rumo</string>
		<string>--profile</string>
		<string>default</string>
		<string>internal</string>
		<string>dispatch</string>
	</array>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/var/tester/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/tester/.local/state/rumo/profiles/default/logs/launchd.dispatch.log</string>
	<key>StandardErrorPath</key>
	<string>/var/tester/.local/state/rumo/profiles/default/logs/launchd.dispatch.log</string>
</dict>
</plist>
