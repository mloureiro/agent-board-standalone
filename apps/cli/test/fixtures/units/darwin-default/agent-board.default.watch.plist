<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agent-board.default.watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/tester/.local/bin/board</string>
		<string>--profile</string>
		<string>default</string>
		<string>internal</string>
		<string>watch</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/var/tester/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/tester/.local/state/agent-board/profiles/default/logs/launchd.watch.log</string>
	<key>StandardErrorPath</key>
	<string>/var/tester/.local/state/agent-board/profiles/default/logs/launchd.watch.log</string>
</dict>
</plist>
