{
  "name": "@agent-board/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked -p agent-board-bridge-core",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked -p agent-board-bridge-core --all-targets -- -D warnings",
    "build:shim": "esbuild src/bridge/install.ts --bundle --format=iife --minify --outfile=src-tauri/shim.js",
    "bundle": "rm -rf dist-web && cp -R ../web/dist dist-web && pnpm run build:shim",
    "phone": "playwright test"
  },
  "dependencies": {
    "@agent-board/web": "workspace:^0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "esbuild": "^0.28.2"
  }
}
